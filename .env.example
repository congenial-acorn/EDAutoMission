# Mission Settings
ED_MAX_MISSIONS=20
ED_POLL_INTERVAL=10
ED_POLL_OFFSET=5
ED_LOOP_SLEEP=20

# Feature Flags
ED_DRY_RUN=false
ED_DEBUG_OCR=false
ED_INTERACTIVE=true

# Discord Integration (leave blank to disable)
DISCORD_WEBHOOK_URL=

# Tesseract OCR Path (optional - platform-specific defaults handled in setup)
TESSERACT_PATH=

# Timing & Thresholds
ED_NAVIGATION_DELAY=5.0
ED_INPUT_INTERVAL=0.3
ED_BACK_BUTTON_MSE_THRESHOLD=1.0
ED_WING_ICON_MSE_THRESHOLD=5000.0
